# Copy to `.env` and fill in. `.env` is gitignored.
#
# Every var here is EXPO_PUBLIC_*, which Expo INLINES INTO THE JS BUNDLE at
# build time. They ship inside the binary and can be extracted from it, so none
# of these is a secret. Never put a service-role key or any server-side
# credential in this file -- the Supabase key below is the public anon key,
# whose real boundary is row-level security, and the Maps key must be
# restricted by API and by app in Google Cloud Console.
#
# A local `.env` covers local builds only. EAS Build never sees it (the file is
# gitignored, so it is not in the uploaded archive) -- set those separately:
#   eas env:create --environment development --name EXPO_PUBLIC_SUPABASE_URL --value "..."


# --- Required: the app cannot function without these ------------------------
# services/supabase.ts used to raise "Missing Supabase env vars" on import,
# which killed the app before the first render -- a white screen with nothing
# in the UI, the logs, or Sentry. It now exports `supabaseConfigError` instead,
# and app/_layout.tsx renders a screen naming exactly which variables are
# absent. The app still cannot do anything useful; it just says why.
#
# These are inlined at BUILD time, so a missing one is a property of the binary.
# No amount of signing in or reinstalling fixes it -- it has to be rebuilt.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key


# --- Required in practice: the map is a core feature -----------------------
# Read by app.config.ts and passed to the native Google Maps SDKs. Without it
# the app still starts, but the map screen renders blank or unstyled tiles.
# Needs "Maps SDK for Android" and "Maps SDK for iOS" enabled on the key.

EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key


# --- Optional: absence degrades a feature, it does not break the app -------

# Crash reporting (services/logger.ts). Unset -> Sentry never initializes and
# the app logs "[Logger] Sentry DSN not found. Crash reporting is disabled."
EXPO_PUBLIC_SENTRY_DSN=
# Separates one release channel's crashes from another. Defaults to NODE_ENV,
# else "development".
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
# Performance tracing. Defaults to 0 (off) -- tracing is the bulk of event
# volume, so raise it deliberately.
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# Product analytics (services/analytics.ts). Unset -> PostHog is disabled and
# the app logs "[Analytics] PostHog API Key not found."
EXPO_PUBLIC_POSTHOG_API_KEY=
# Defaults to https://app.posthog.com. Set only for self-hosted or EU cloud.
EXPO_PUBLIC_POSTHOG_HOST=

# Legal document URLs (constants/legal.ts). A publicly reachable privacy policy
# is a hard requirement for Google Play closed testing and App Store review.
# PRIVACY_POLICY_URL defaults to the rendered Markdown in this repo; point it at
# your own fork, or override it once the documents are hosted on a real domain.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=

# Public web origin for shareable deal links, e.g. https://example.com
# (constants/links.ts). Empty on purpose until a domain is deployed: sharing
# returns null rather than emitting a happyhourfinder:// URL that does nothing
# for a recipient without the app installed.
EXPO_PUBLIC_WEB_BASE_URL=

# Photo scanning (services/dealScanService.ts). The n8n intake API's scan
# endpoint — normally https://n8n.example.com/webhook/hh-deal-scan. Unset ->
# the "Read the deal from this photo" button is hidden and the submit form
# works exactly as it did before; a photo is still uploaded and attached to
# the submission as evidence.
#
# There is deliberately no token here. The endpoint authenticates the signed-in
# user with their own Supabase access token, precisely because everything in
# this file ships inside the binary and is therefore not a secret.
EXPO_PUBLIC_HH_SCAN_URL=
